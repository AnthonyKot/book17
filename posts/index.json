[('00', 'A Ranking of Tested Applications', 'The OWASP Top 10 is the list every security team cites. Its 2025 edition ranks ten classes of weakness. Here is what the ranking actually measures, what it cannot, and what ten famous breaches look like when each is read against its own primary record.', '00-v6.md'), ('01', 'The Firewall Could Read the Bank', 'Capital One, 2019. The server-side request forgery everyone cites is not in the court record. The permission is.', '01-v3.md'), ('02', 'Three Defaults, Not One', "The MongoDB ransom wave, 2017. The headline says the database shipped open and version 3.6 closed it. The vendor's own bug tracker says the fix was three years old, and the wave fell where no default reached.", '02-v1.md'), ('03', 'The Tarball Was Not the Tree', 'The xz backdoor, 2024. The story everyone tells is about a patient stranger. The record is about a file that was never in git.', '03-v5.md'), ('04', 'The Backup That Outlived the Fix', 'Adobe, 2013. The story says the passwords were never properly protected. The regulators say the proper system had been running for three years. What the attackers took was the copy nobody had deleted.', '04-v6.md'), ('05', 'One Function, Three Patches', 'MOVEit, 2023. The story is one zero-day in a file-transfer product, patched in a day. The patch diff shows a function that did escape its input, for three uses out of four, and two more patches inside fifteen days.', '05-v6.md'), ('06', 'What "Turn Off GPS" Left Out', "Strava, 2018. A fitness app's map drew the outlines of military bases. The story says the company gave them away and the Pentagon banned the trackers. The documents say the map worked exactly as designed, and that the design was the problem.", '06-v6.md'), ('07', 'The Door Colonial Could Not See', '', '07-v2.md'), ('08', 'The Backup That Was Not a Backup', 'Maersk and NotPetya, 2017. The story ends with one server in Ghana saved by a power cut. The record says the survivor was a live copy, not a backup, and that the difference is the whole lesson.', '08-v6.md'), ('09', 'Between Alert and Action', "Target, 2013. The story is that the alarm went off and nobody looked. Target's own testimony says something narrower and stranger: the activity was detected, logged, surfaced and evaluated. What happened after that is the gap nobody has filled.", '09-v6.md'), ('10', 'One Line Too Many, One Field Too Few', "Apple's goto fail, 2014, and CrowdStrike's Channel File 291, 2024. Two bugs that failed in opposite directions, and why neither fix is the lesson.", '10-v4.md')]